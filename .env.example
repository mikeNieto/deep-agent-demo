API_HOST=0.0.0.0
API_PORT=8000

# Google Gemini (LLM + STT). AI Studio key or Cloud Console key.
GOOGLE_API_KEY=

# Optional: separate key for Cloud Text-to-Speech. Falls back to GOOGLE_API_KEY.
# Use this if your GOOGLE_API_KEY is an AI Studio key (only works with Gemini).
GOOGLE_CLOUD_API_KEY=

DEEPAGENT_MODEL=gemini-2.5-flash

STT_MODEL=gemini-2.5-flash

# Google Cloud Text-to-Speech (WaveNet) — free tier: 1M chars/month
# Western female voices. Change these to any WaveNet voice name.
TTS_VOICE_EN=en-US-Wavenet-F
TTS_VOICE_ES=es-ES-Wavenet-C

THINKING_LEVEL=MINIMAL
THINKING_BUDGET=

AUDIO_TEMP_DIR=data/audio
